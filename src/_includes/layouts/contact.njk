{% extends "base.njk" %} {% block content %}

<section class="section">
  <div class="container form-container">
    <div class="form-title">
      <h4>{{title}}</h4>
      <p>{{subTitle}}</p>
    </div>

    <p class="contact-help">Name, email, and message are required. Website and phone are optional.</p>
    <p class="contact-help">You can also email <a href="mailto:info@entrenets.com">info@entrenets.com</a>. We respond within two business days.</p>
    <form id="business-inquiry" data-thanks-url="/thanks/" action="https://api.web3forms.com/submit" method="POST">
      <input
        type="hidden"
        name="access_key"
        value="0f7b2452-3ca9-43d1-932f-ccca45046387"
      />
      <input
        type="hidden"
        name="subject"
        value="New Submission from Entrenets website"
      />
      <input type="hidden" name="from_name" value="Entrenets" />
      <div class="form-row">
        <div class="form-item">
          <label for="name" class="contact-form-label required-field"
            >Your Name</label
          >
          <input type="text" name="name" id="name" autocomplete="name" required placeholder="Full Name" />
        </div>
        <div class="form-item">
          <label for="email" class="contact-form-label required-field"
            >Email Address</label
          >
          <input
            type="email"
            name="email"
            id="email"
            required
            placeholder="name@company.com"
            autocomplete="email"
          />
        </div>
      </div>

      <div class="form-row">
        <div class="form-item">
          <label for="website" class="contact-form-label"
            >Website URL (optional)</label
          >
          <input
            type="url"
            name="website"
            id="website"
            autocomplete="url"
            placeholder="https://company.com"
          />
        </div>
        <div class="form-item">
          <label for="phone" class="contact-form-label"
            >Phone number (optional)</label
          >
          <input
            type="tel"
            name="phone"
            id="phone"
            autocomplete="tel"
            title="Use international format, for example +14155552671"
            placeholder="+14155552671"
            pattern="^\+[1-9]\d{1,14}$"
          />
        </div>
      </div>

      <label for="message" class="contact-form-label required-field"
        >Tell us about the project</label
      >
      <textarea
        class="form-control message"
        name="message"
        id="message"
        rows="6"
        minlength="5"
        required
        placeholder="Please provide all details about your project"
      ></textarea>

      <!-- Honeypot Spam Protection -->
      <input
        type="checkbox"
        name="botcheck"
        class="hidden"
        tabindex="-1"
        aria-hidden="true"
        style="display: none"
      />

      <div id="inquiry-captcha" class="h-captcha" data-sitekey="50b2fe65-b00b-4b9e-ad62-3ba471098be2" data-theme="dark"></div>
      <noscript><p class="contact-help">Please email info@entrenets.com. This protected form requires JavaScript.</p></noscript>

      <button type="submit" class="btn btn-primary" disabled>
        <span class="btn-area">
          <span data-text="{{btnText}}"> {{btnText}} </span>
        </span>
      </button>
    </form>
    <p id="inquiry-status" role="status" tabindex="-1"></p>

  </div>
</section>

{% endblock %} {% block workTogether %}{% endblock %}

{% block scripts %}
<script src="/assets/js/contact.js"></script>
<script id="captcha-script" src="https://js.hcaptcha.com/1/api.js?onload=inquiryCaptchaReady&amp;render=explicit&amp;recaptchacompat=off" async defer></script>
{% endblock %}
